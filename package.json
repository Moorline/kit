{
  "name": "moorline-kit-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Moorline package authoring SDK and tooling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Moorline/kit.git"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && bun run build:packages",
    "build:packages": "bun run --filter './packages/*' build",
    "check:fast": "bun run typecheck && bun run lint && bun run test:fast",
    "check": "bun run check:fast && bun run validate:sample",
    "validate:sample": "bun run build:packages && bun run test:sample",
    "test:sample": "vitest run tests/unit/package-kit.test.ts --testNamePattern \"bundles, validates, and inspects installable source packages\"",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fast": "vitest run tests/unit/package-kit*.test.ts tests/contract/*.test.ts"
  },
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.21.0",
    "tar": "^7.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
